{
  "name": "@z-astral/baileys",
  "type": "module",
  "version": "1.0.0",
  "description": "Next-generation Baileys with native GenAI Rich UI, Interactive HTML, Carousel, VoIP, and Newsletter support",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z-astral/baileys.git"
  },
  "files": [
    "lib/**/*",
    "WAProto/**/*"
  ],
  "scripts": {
    "build": "node -e \"const{execSync:e}=require('child_process');try{e('npx tsc -P tsconfig.build.json',{stdio:'inherit'})}catch(x){};e('npx tsc-esm-fix --tsconfig=tsconfig.build.json --ext=.js',{stdio:'inherit'})\""
  },
  "keywords": [
    "baileys",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "z-astral",
    "multi-device",
    "bot",
    "automation",
    "interactive-messages",
    "rich-html",
    "genai",
    "voip",
    "voice-call"
  ],
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.0",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.7.0",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.2.4",
    "whatsapp-rust-bridge": "0.5.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/ws": "^8.0.0",
    "link-preview-js": "^3.0.0",
    "protobufjs-cli": "^1.1.2",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@roamhq/wrtc": "*",
    "audio-decode": "^2.1.3",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.0",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "@roamhq/wrtc": {
      "optional": true
    },
    "audio-decode": {
      "optional": true
    },
    "fluent-ffmpeg": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}